<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares this app as a voice-interaction-capable assistant.
  sessionService is launched by the system when an assist gesture occurs.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="dev.telepathos/.TelepathosInteractionSessionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false" />
